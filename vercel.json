{
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": true,
  "functions": {
    "api/capture.js": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/capture?path=/" },
    { "source": "/jobs", "destination": "/api/capture?path=/jobs" },
    { "source": "/jobs/:path*", "destination": "/api/capture?path=/jobs/:path*" },
    { "source": "/categories", "destination": "/api/capture?path=/categories" },
    { "source": "/countries", "destination": "/api/capture?path=/countries" },
    { "source": "/articles", "destination": "/api/capture?path=/articles" },
    { "source": "/articles/:path*", "destination": "/api/capture?path=/articles/:path*" },
    { "source": "/faq", "destination": "/api/capture?path=/faq" },
    { "source": "/about", "destination": "/api/capture?path=/about" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    },
    {
      "source": "/about.html",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
