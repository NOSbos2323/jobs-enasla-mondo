{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/og-image.png", "dest": "/og-image.png" },
    { "src": "/favicon.ico", "dest": "/favicon.ico" },
    { "src": "/_redirects", "dest": "/_redirects" },
    { "src": "/public/(.*)", "dest": "/public/$1" },
    { "src": "/jobs", "dest": "/index.html" },
    { "src": "/jobs/(.*)", "dest": "/index.html" },
    { "src": "/categories", "dest": "/index.html" },
    { "src": "/categories/(.*)", "dest": "/index.html" },
    { "src": "/countries", "dest": "/index.html" },
    { "src": "/countries/(.*)", "dest": "/index.html" },
    { "src": "/articles", "dest": "/index.html" },
    { "src": "/articles/(.*)", "dest": "/index.html" },
    { "src": "/faq", "dest": "/index.html" },
    { "src": "/about", "dest": "/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
