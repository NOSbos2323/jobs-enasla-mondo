{
  "outputDirectory": ".",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/og-image.png", "destination": "/og-image.png" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/jobs/:path*", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/categories/:path*", "destination": "/index.html" },
    { "source": "/countries", "destination": "/index.html" },
    { "source": "/countries/:path*", "destination": "/index.html" },
    { "source": "/articles", "destination": "/index.html" },
    { "source": "/articles/:path*", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
